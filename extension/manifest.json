{
  "manifest_version": 3,
  "name": "Ticket Tracker Quick Stamp",
  "version": "1.1.0",
  "description": "Capture a call-answer timestamp from xTool and send it to Ticket Tracker.",
  "permissions": ["storage", "tabs"],
  "background": {"service_worker": "background.js"},
  "commands": {
    "quick-stamp": {
      "suggested_key": {
        "default": "Ctrl+Shift+Space"
      },
      "description": "Stamp the current call answer time"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://owl.xtool.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://ticketing-1n5.pages.dev/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
