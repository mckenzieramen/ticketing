{
  "manifest_version": 3,
  "name": "Ticket Tracker Quick Stamp",
  "version": "1.0.0",
  "description": "Keyboard shortcut helper for Ticket Tracker.",
  "permissions": ["storage"],
  "background": {"service_worker": "background.js"},
  "content_scripts": [{"matches": ["https://owl.xtool.com/*"], "js": ["content.js"], "run_at": "document_start"}]
}